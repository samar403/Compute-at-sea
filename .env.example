# Port for the API + production web server
PORT=8787
# Where the SQLite database lives (created on first run)
DATA_DIR=./data
# Simulation clock speed relative to wall-clock time (60 = one sim-minute per real second)
SIM_SPEED=60
# Optional: enables the AI Bridge Officer (Claude). Without it, a deterministic rules engine answers.
ANTHROPIC_API_KEY=
# Optional override of the Claude model used by the Bridge Officer
BRIDGE_MODEL=claude-opus-5-5
